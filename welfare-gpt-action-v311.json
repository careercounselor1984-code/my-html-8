{
  "openapi": "3.1.1",
  "info": {
    "title": "Welfare Policy Search API",
    "version": "1.1.0",
    "description": "Search Korean central and local welfare services using age, region, employment status, interest area, and keyword."
  },
  "servers": [
    {
      "url": "https://bowxlaiyjxknqccoughl.supabase.co/functions/v1/welfare-proxy"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "searchWelfarePolicies",
        "summary": "Search personalized welfare policies",
        "description": "Search and rank central and local welfare service candidates using the user's age, residence, employment status, interest area, and keyword. Results do not guarantee eligibility and official requirements must be verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["search"]
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120,
                    "description": "User age in full years. Example: 29"
                  },
                  "sido": {
                    "type": "string",
                    "description": "Province or metropolitan city. Example: 울산광역시"
                  },
                  "sigungu": {
                    "type": "string",
                    "description": "City, county, or district. Example: 북구"
                  },
                  "employmentStatus": {
                    "type": "string",
                    "description": "Employment status such as 미취업, 재직중, 단시간근로, 자영업"
                  },
                  "interest": {
                    "type": "string",
                    "description": "Main interest area such as 취업, 주거, 금융, 생계, 의료, 돌봄, 교육, 청년"
                  },
                  "keyword": {
                    "type": "string",
                    "description": "Optional additional search keyword extracted from the user's question"
                  }
                },
                "required": ["action"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "profile": {
                      "type": "object",
                      "properties": {
                        "age": {"type": "integer"},
                        "sido": {"type": "string"},
                        "sigungu": {"type": "string"},
                        "employmentStatus": {"type": "string"},
                        "interest": {"type": "string"},
                        "keyword": {"type": "string"}
                      }
                    },
                    "queries": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "total": {"type": "integer"},
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "source": {"type": "string"},
                          "name": {"type": "string"},
                          "agency": {"type": "string"},
                          "summary": {"type": "string"},
                          "target": {"type": "string"},
                          "category": {"type": "string"},
                          "link": {"type": "string"},
                          "matchScore": {"type": "integer"},
                          "matchReasons": {
                            "type": "array",
                            "items": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {"description": "Bad request"},
          "500": {"description": "Server error"}
        }
      }
    }
  }
}
