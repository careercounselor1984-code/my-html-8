{
  "openapi": "3.1.1",
  "info": {
    "title": "Welfare Policy Search API",
    "version": "1.0.0",
    "description": "Search Korean central and local welfare services for counseling support."
  },
  "servers": [
    {
      "url": "https://bowxlaiyjxknqccoughl.supabase.co/functions/v1/welfare-proxy"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "searchWelfarePolicies",
        "summary": "Search welfare policies",
        "description": "Search central and local welfare service candidates by keyword. Results do not guarantee eligibility and must be verified against official requirements.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["search"]
                  },
                  "keyword": {
                    "type": "string",
                    "description": "Search keyword such as 주거, 청년, 취업, 금융, 돌봄, 생계"
                  }
                },
                "required": ["action"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
